
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox
        class="travelDetailsWatermark"
        width="100%"
        visible="{= !!${travelSelection>/TravelID} }">

        <!-- Letterhead -->
        <VBox
            class="travelLetterhead"
            width="100%"
            alignItems="Center">

            <Title
                text="SELECTED TRAVEL DETAILS"
                level="H2"
                class="travelLetterheadTitle"/>

            <!-- Horizontal blue line -->
            <core:HTML
                content="&lt;div style='width:100%;height:2px;background-color:#174A7E;'&gt;&lt;/div&gt;"/>

        </VBox>

        <!-- Travel Information -->
        <VBox class="travelInformationSection">

            <Title
                text="TRAVEL INFORMATION"
                level="H4"
                class="travelInformationTitle"/>

            <!-- Row 1 -->
            <HBox class="travelDetailRow" width="100%">
                <HBox class="travelDetailItem" width="50%">
                    <Label text="Travel ID:"/>
                    <Text text="{travelSelection>/TravelID}"/>
                </HBox>

                <HBox class="travelDetailItem" width="50%">
                    <Label text="Agency ID:"/>
                    <Text text="{travelSelection>/AgencyID}"/>
                </HBox>
            </HBox>

            <!-- Row 2 -->
            <HBox class="travelDetailRow" width="100%">
                <HBox class="travelDetailItem" width="50%">
                    <Label text="Customer ID:"/>
                    <Text text="{travelSelection>/CustomerID}"/>
                </HBox>

                <HBox class="travelDetailItem" width="50%">
                    <Label text="Description:"/>
                    <Text
                        text="{travelSelection>/Description}"
                        wrapping="true"/>
                </HBox>
            </HBox>

            <!-- Row 3 -->
            <HBox class="travelDetailRow" width="100%">
                <HBox class="travelDetailItem" width="50%">
                    <Label text="Starting Date:"/>
                    <Text text="{travelSelection>/BeginDate}"/>
                </HBox>

                <HBox class="travelDetailItem" width="50%">
                    <Label text="End Date:"/>
                    <Text text="{travelSelection>/EndDate}"/>
                </HBox>
            </HBox>

            <!-- Row 4 -->
            <HBox class="travelDetailRow" width="100%">
                <HBox class="travelDetailItem" width="50%">
                    <Label text="Total Price:"/>
                    <Text text="{travelSelection>/TotalPrice}"/>
                </HBox>
            </HBox>

        </VBox>

    </VBox>

</core:FragmentDefinition>
